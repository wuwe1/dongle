# BLE peripheral only, NimBLE host
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
# More buffers for bursts of notifications
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=32
# The console on the chip's own USB (ESP32-S3 / C3): fast enough for every frame of a busy bus,
# where a 115200 UART would carry about 250 lines a second
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_FREERTOS_HZ=1000
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
